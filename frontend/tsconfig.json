{
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" }
  ],
  // The shadcn CLI reads the "@/*" alias from here (not tsconfig.app.json);
  // without it, `shadcn add` writes into a literal "@" folder.
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
