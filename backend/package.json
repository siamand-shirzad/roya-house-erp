{
  "name": "roya-house-backend",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:setup": "tsx prisma/seed.ts",
    "prisma:seed": "tsx prisma/seed.ts",
    "hash-password": "node -e \"require('fs').existsSync('dist/scripts/hash-password.js') ? require('child_process').spawnSync(process.execPath, ['dist/scripts/hash-password.js', ...process.argv.slice(1)], {stdio:'inherit'}) : require('child_process').spawnSync('npx', ['tsx', 'src/scripts/hash-password.ts', ...process.argv.slice(1)], {stdio:'inherit', shell:true})\" --",
    "test:integration": "npm run build && node --test tests/lifecycle.cjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
